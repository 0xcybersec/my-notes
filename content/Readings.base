views:
  - type: cards
    name: Card View
    filters:
      and:
        - file.inFolder("content/Readings")
    groupBy:
      property: file.folder
      direction: ASC
    image: note.Cover
    imageAspectRatio: 2
    cardSize: 220
  - type: table
    name: Book List
    filters:
      and:
        - file.folder == "content/Readings"
    order:
      - file.name
      - tags
      - Author

views:
  - type: cards
    name: Card View
    filters:
      and:
        - file.inFolder == "Readings"
    groupBy:
      property: file.folder
      direction: ASC
    image: note.cover
  - type: table
    name: Book List
    filters:
      and:
        - file.folder == "content/Readings"
    order:
      - file.name
      - tags
      - Author


views:
  - type: cards
    name: Card View
    filters:
      and:
        - file.inFolder("content/Readings")
    groupBy:
      property: tags
      direction: ASC
    image: note.Cover
    imageAspectRatio: 1.2
    cardSize: 200
    imageFit: contain
  - type: list
    name: Book List
    filters:
      and:
        - file.folder == "content/Readings"
    order:
      - file.name
      - tags
      - Author
    markers: none
  - type: cards
    name: Test
    filters:
      and:
        - file.inFolder("content/Readings")
    order:
      - file.name
      - Covertest
    image: note.Covertest

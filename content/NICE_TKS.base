views:
  - type: table
    name: 视图
    filters:
      or:
        - file.folder == "content/Frameworks/NICE_DD_WRL-001/Tasks (50)"
        - file.folder == "content/Frameworks/NICE_DD_WRL-001/Skills (48)"
        - file.folder == "content/Frameworks/NICE_DD_WRL-001/Knowledge (121)"
    order:
      - file.name
      - TKS ID
      - TKS Description
    sort:
      - property: TKS ID
        direction: ASC
    columnSize:
      file.name: 281

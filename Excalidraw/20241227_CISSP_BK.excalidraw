			"type": "text",
			"x": 5304.361111111113,
			"y": 557.8888888888887,
			"width": 1308.275634765625,
			"height": 360,
			"angle": 0,
			"strokeColor": "#e03131",
			"backgroundColor": "#ffec99",
			"fillStyle": "hachure",
			"strokeWidth": 4,
			"strokeStyle": "dashed",

		{
			"id": "uQZ6aVEq",
			"type": "text",
			"x": 13565.365546143257,
			"y": 6761.846131873635,
			"width": 745.1278076171875,
			"height": 1395,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#a5d8ff",
			"fillStyle": "solid",
			"strokeWidth": 4,
			"strokeStyle": "solid",

		{
			"id": "oHm2qgXJ",
			"type": "text",
			"x": 21519.361111111113,
			"y": 1488.4444444444453,
			"width": 816.44384765625,
			"height": 855,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#b2f2bb",
			"fillStyle": "hachure",
			"strokeWidth": 4,
			"strokeStyle": "dotted",
			"roughness": 2,

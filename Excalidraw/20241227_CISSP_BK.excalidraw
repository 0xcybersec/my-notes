			"height": 45,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#ffec99",
			"fillStyle": "hachure",
			"strokeWidth": 4,
			"strokeStyle": "dashed",
			"roughness": 2,
			"opacity": 100,

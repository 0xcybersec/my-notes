			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b2T",
			"roundness": null,
			"seed": 1633406505,
			"version": 295,
			"versionNonce": 2094469161,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1733839558913,
			"link": null,
			"locked": false,
			"text": "Data3态\n- Data in rest: disks, tapes, CD/DVD, USB, etc. (加密使用硬件或软件方式）\n- Data in transit: 还是加密（包括内网和外网），内网用Https认证\n- Data in use: 唯一不能被加密的状态\n提唱方法\nClean desk, print policy \nno shoulder surfing 防偷窥膜（PC+手机）\n锁屏（默认15min)",
			"fontSize": 36,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "HK_5dyqGNiuE1BswnOjR9",
			"originalText": "Data3态\n- Data in rest: disks, tapes, CD/DVD, USB, etc. (加密使用硬件或软件方式）\n- Data in transit: 还是加密（包括内网和外网），内网用Https认证\n- Data in use: 唯一不能被加密的状态\n提唱方法\nClean desk, print policy \nno shoulder surfing 防偷窥膜（PC+手机）\n锁屏（默认15min)",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"hasTextLink": false,
			"rawText": "",
			"labelPosition": null,
			"baseFontSize": null
		},

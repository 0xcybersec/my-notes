		{
			"id": "GARMCnku",
			"type": "text",
			"x": 6499.611111111115,
			"y": 5558.027777777777,
			"width": 809.7117919921875,
			"height": 630,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#a5d8ff",
			"fillStyle": "hachure",
			"strokeWidth": 4,

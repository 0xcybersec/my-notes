			"seed": 193537608,
			"version": 646,
			"versionNonce": 1482522936,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1734358567312,
			"link": null,
			"locked": false,
			"text": "1)Patch Management\nOS patches\nNetwork equipment updates\narray updates\nIoT updates\ncommon tools\n    - SCCM\n    - WSUS\ntime to push the patches (weekends, etc.)\n\n2)Change Management\nChange review board (CRB)\n- Identifying\n- Propose\n- Assess the risks, impacts and benefits\n- Provisional change approval\n- Test the change\n- Scheduling the change\n- Change notification for impacted parties\n- Implementing the change\n- Post reporting\n\n3) 0-day Vulnerabilities\n- 0-day vulnerability\n- 0-day Exploit\n- 0-day attack\n\nStuxnet has three modules\n- a worm\n- a link\n- a rootkit",
			"fontSize": 36,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "sATM9hClYkR0awA-n2Q1A",
			"originalText": "1)Patch Management\nOS patches\nNetwork equipment updates\narray updates\nIoT updates\ncommon tools\n    - SCCM\n    - WSUS\ntime to push the patches (weekends, etc.)\n\n2)Change Management\nChange review board (CRB)\n- Identifying\n- Propose\n- Assess the risks, impacts and benefits\n- Provisional change approval\n- Test the change\n- Scheduling the change\n- Change notification for impacted parties\n- Implementing the change\n- Post reporting\n\n3) 0-day Vulnerabilities\n- 0-day vulnerability\n- 0-day Exploit\n- 0-day attack\n\nStuxnet has three modules\n- a worm\n- a link\n- a rootkit",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"hasTextLink": false,
			"rawText": "",
			"labelPosition": null,
			"baseFontSize": null

		{
			"id": "lEYhFISQ",
			"type": "text",
			"x": 2004.3597972128262,
			"y": 3254.4295642571265,
			"width": 583.9957275390625,
			"height": 1050,
			"angle": 0,
			"strokeColor": "#e03131",
			"backgroundColor": "#ffec99",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bEW",
			"roundness": null,
			"seed": 409009761,
			"version": 1821,
			"versionNonce": 1246851393,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1735286149831,
			"link": null,
			"locked": false,
			"text": "如何选择Security Model\n- The type of users\n- The Type of data\n- The type of levels of users\n1) Dedicated security mode\nAll Users\n    - signed NDA for all info\n    - proper clearance of all info\n    - Formal access approval for all info\n    - A valid need to know for all\n    - All users can access All data\n2) System High security Mode\n    - Signed NDA for all\n    - Proper clearance for all\n    - Formal access approval for all\n    - A valid need to know of some info\n    - All Users can access some data\n3) Compartmented security Mode\n    隔离\n    - signed NDA\n    - Proper clearance\n    - Formal access approval for some\n    - A valid need to know for some\n    - All users can access some data\n4) Multilevel security mode (controlled~)\n    - Signed NDA for all\n    - Proper clearance for some information\n    - Formal access approval for some\n    - A valid need to know for some\n    - all users can access some data",
			"fontSize": 28,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "CEkSKXtcf73R4_S4Cgqvy",
			"originalText": "如何选择Security Model\n- The type of users\n- The Type of data\n- The type of levels of users\n1) Dedicated security mode\nAll Users\n    - signed NDA for all info\n    - proper clearance of all info\n    - Formal access approval for all info\n    - A valid need to know for all\n    - All users can access All data\n2) System High security Mode\n    - Signed NDA for all\n    - Proper clearance for all\n    - Formal access approval for all\n    - A valid need to know of some info\n    - All Users can access some data\n3) Compartmented security Mode\n    隔离\n    - signed NDA\n    - Proper clearance\n    - Formal access approval for some\n    - A valid need to know for some\n    - All users can access some data\n4) Multilevel security mode (controlled~)\n    - Signed NDA for all\n    - Proper clearance for some information\n    - Formal access approval for some\n    - A valid need to know for some\n    - all users can access some data",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"hasTextLink": false,
			"rawText": "",
			"labelPosition": null,
			"baseFontSize": null
		},

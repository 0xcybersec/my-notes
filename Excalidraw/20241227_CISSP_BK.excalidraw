			"isDeleted": false,
			"boundElements": [],
			"updated": 1795530721350,
			"link": null,
			"locked": false,
			"text": "1) Static Testing //only test, no run\n2) Dynamic Testing //run it\n3) Fuzzing\nA black box with random, malformed 畸形的data\nto see if crush\n4) Pen Testing for physical and logical\nperimeter\n5) Synthetic Transactions/Monitoring\n用脚本或工具来模拟正常用户行为\n",
			"fontSize": 36,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "X_i0fD31rrxgXH8POW8sX",
			"originalText": "1) Static Testing //only test, no run\n2) Dynamic Testing //run it\n3) Fuzzing\nA black box with random, malformed 畸形的data\nto see if crush\n4) Pen Testing for physical and logical\nperimeter\n5) Synthetic Transactions/Monitoring\n用脚本或工具来模拟正常用户行为\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,

			"seed": 2073679750,
			"version": 95,
			"versionNonce": 1691168082,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795530721350,
			"link": null,
			"locked": false,
			"text": "NIST 800-2",
			"fontSize": 36,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "dPCMNUsNMl79ltNnj1SfV",
			"originalText": "NIST 800-2",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"hasTextLink": false,
			"rawText": "",
			"labelPosition": null,
			"baseFontSize": null
		},
		{
			"id": "hOLBDuaM",
			"type": "text",
			"x": 18654.694444444445,
			"y": 1633.1111111111118,
			"width": 1522.3359375,
			"height": 900,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#a5d8ff",
			"fillStyle": "hachure",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 2,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b5W",
			"roundness": null,
			"seed": 1298688410,
			"version": 1034,
			"versionNonce": 982359489,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1734877096784,
			"link": null,
			"locked": false,
			"text": "针对Logs收集的要求\n1.Network Security SW/HW\nAntivirus logs, IPS/IDS logs, remote access software(如VPN）\nweb proxy, vulnerability management\n2. OS:\nSystem events (对MacOS Authentication servers, routers and firewalls要研究下）\nAudit records, applications, client request, server response,\nusage information, significant operational actions\n集中化，独立性\nautomated, secure, even administrators should have limited access只能看不能改\n另外，各日志的时间同步也要确认\n一般原本(Original data)是hashed and never touched 副本用于分析以保证完整性\nLog的Retention Policy\nLogs不光是存在那，要发挥价值需要自动分析工具\n5个误区\n- Logs not reviewed an a regular and timely basis\n- Audit logs and audit trails not stored for a long enough time\n- Logs not standardized or viewable by correlation toolset\n- Log entries and alerts are not prioritized\n- Audit records are only reviewed for the bad stuff",
			"fontSize": 36,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "针对Logs收集的要求\n1.Network Security SW/HW\nAntivirus logs, IPS/IDS logs, remote access software(如VPN）\nweb proxy, vulnerability management\n2. OS:\nSystem events (对MacOS Authentication servers, routers and firewalls要研究下）\nAudit records, applications, client request, server response,\nusage information, significant operational actions\n集中化，独立性\nautomated, secure, even administrators should have limited access只能看不能改\n另外，各日志的时间同步也要确认\n一般原本(Original data)是hashed and never touched 副本用于分析以保证完整性\nLog的Retention Policy\nLogs不光是存在那，要发挥价值需要自动分析工具\n5个误区\n- Logs not reviewed an a regular and timely basis\n- Audit logs and audit trails not stored for a long enough time\n- Logs not standardized or viewable by correlation toolset\n- Log entries and alerts are not prioritized\n- Audit records are only reviewed for the bad stuff",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"hasTextLink": false,
			"rawText": "",
			"labelPosition": null,
			"baseFontSize": null
		},

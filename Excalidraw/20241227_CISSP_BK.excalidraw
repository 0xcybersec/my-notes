		{
			"id": "LwH65OY0",
			"type": "text",
			"x": 21656.318130546162,
			"y": 3559.3104368104177,
			"width": 1425.59912109375,
			"height": 3420,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#b2f2bb",
			"fillStyle": "cross-hatch",
			"strokeWidth": 4,
